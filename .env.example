# LOCAL ONLY. Never commit a populated file. Supabase injects SUPABASE_* at runtime.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
INVITATION_CALLBACK_URL=http://localhost:5173/auth/invitation
# Three independent random secrets (at least 32 characters), not the service role key.
WORKER_SECRET=
BREVO_WEBHOOK_SECRET=
INVITATION_TOKEN_SECRET=
ASSET_URL_TTL_SECONDS=120
# Leave blank locally unless explicitly testing delivery with a synthetic mailbox.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
