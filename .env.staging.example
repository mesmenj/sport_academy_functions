# STAGING template. Copy to supabase/functions/.env.staging (git-ignored), fill,
# then run: npm run staging:preflight -- --project-ref <ref> --env supabase/functions/.env.staging
# Never commit a populated file. Supabase injects SUPABASE_* at runtime: do not set them.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Exact HTTPS origins of the staging Web apps, comma separated, no wildcard.
ALLOWED_ORIGINS=https://<academy-staging-host>,https://<platform-staging-host>
INVITATION_CALLBACK_URL=https://<academy-staging-host>/auth/invitation
# Three NEW independent random secrets (openssl rand -hex 32), never the local ones.
WORKER_SECRET=
BREVO_WEBHOOK_SECRET=
INVITATION_TOKEN_SECRET=
# Signed asset URL lifetime, 30..300 seconds.
ASSET_URL_TTL_SECONDS=120
# Both empty (no external email) or both set (decision required before staging).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
